/* PDF Accessibility Inspector - Enterprise Clean Modern Theme */

QMainWindow {
    background-color: #f4f6f8;
    color: #0f172a;
    font-family: "Segoe UI", -apple-system, Roboto, sans-serif;
    font-size: 10pt;
}

QWidget {
    font-family: "Segoe UI", -apple-system, Roboto, sans-serif;
    font-size: 10pt;
    color: #1e293b;
}

/* ToolBar & Menus */
QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 6px 12px;
    spacing: 8px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
    color: #334155;
}

QToolButton:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    color: #0f172a;
}

QToolButton:pressed {
    background-color: #e2e8f0;
}

/* Sidebar List */
QListWidget#sidebarList {
    background-color: #ffffff;
    border: none;
    border-right: 1px solid #e2e8f0;
    outline: none;
    padding-top: 8px;
}

QListWidget#sidebarList::item {
    height: 38px;
    padding-left: 14px;
    border-radius: 8px;
    margin: 2px 8px;
    color: #475569;
    font-weight: 500;
}

QListWidget#sidebarList::item:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}

QListWidget#sidebarList::item:selected {
    background-color: #ecfccb;
    color: #14532d;
    font-weight: 700;
}

/* Tab Widgets matching Screenshot */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    background: #ffffff;
    border-radius: 0px 0px 8px 8px;
    top: -1px;
}

QTabBar::tab {
    background: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-bottom: none;
    padding: 7px 18px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
    color: #475569;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-color: #94a3b8;
    border-bottom: 2px solid #ffffff;
    color: #0f172a;
}

QTabBar::tab:hover:!selected {
    background: #e2e8f0;
    color: #1e293b;
}

/* Tables and Headers matching Screenshot */
QTableWidget, QTableView, QTreeWidget, QTreeView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    gridline-color: #f1f5f9;
    selection-background-color: #e0f2fe;
    selection-color: #0c4a6e;
    alternate-background-color: #fafbfc;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    padding: 8px 12px;
    font-weight: 600;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #cbd5e1;
}

QHeaderView::section:last {
    border-right: none;
}

/* Buttons */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 500;
    color: #1e293b;
}

QPushButton:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #f1f5f9;
}

QPushButton#primaryBtn {
    background-color: #0c2b1c;
    border: 1px solid #0c2b1c;
    border-radius: 14px;
    color: #ffffff;
    font-weight: 700;
}

QPushButton#primaryBtn:hover {
    background-color: #164e32;
}

/* LineEdits and Inputs */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px 10px;
    color: #0f172a;
}

QLineEdit:focus {
    border-color: #3b82f6;
    outline: none;
}

/* Combo Boxes */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 5px 10px;
    color: #0f172a;
    font-size: 10pt;
}

QComboBox:focus {
    border-color: #3b82f6;
    outline: none;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;
    color: #0f172a;
    font-size: 10pt;
    outline: none;
}

/* ScrollBars */
QScrollBar:vertical {
    background: #f8fafc;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    color: #64748b;
    font-size: 12px;
    padding: 4px 8px;
}

/* GroupBoxes and Frames */
QGroupBox {
    font-weight: 600;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 14px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #334155;
}
